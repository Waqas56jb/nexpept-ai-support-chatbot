# Server
PORT=4000
NODE_ENV=development

# Supabase (API — optional if using direct Postgres only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres (migrate/seed and runtime queries)
# Prefer DATABASE_URL, or use SUPABASE_DB_* parts:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgres
# SUPABASE_DB_HOST=db.your-project.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=YOUR_PASSWORD

# OpenAI (required for full AI replies; FAQ keyword fallback when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
